# ---- Hindsight (historical experience memory) ----
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=
HINDSIGHT_BANK_ID=soc-incident-response

# ---- LLM ----
LLM_API_KEY=
LLM_PROVIDER=anthropic        # anthropic | openai (any OpenAI-compatible endpoint; set LLM_BASE_URL)
LLM_MODEL=                    # blank = provider default
LLM_BASE_URL=                 # optional

# ---- Behaviour ----
USE_HINDSIGHT=false           # default for /incidents/analyze; override per request with "use_hindsight"
LLM_MODE=live                 # live | mock  (mock = offline demo reasoner, no API key)
MEMORY_BACKEND=hindsight      # hindsight | local (local = offline test double, NOT Hindsight)

# HOST=127.0.0.1
# PORT=8000
